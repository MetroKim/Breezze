model Lyrics {
  id        String   @id @default(uuid())
  trackId   String   @unique
  plainText String
  syncedLrc String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LyricTranslation {
  id       String @id @default(uuid())
  lyricsId String
  language String
  text     String

  @@unique([lyricsId, language])
}
