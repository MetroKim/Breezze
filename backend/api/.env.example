# NestJS API
# Verified Supabase identity exchange (publishable key is NOT a service-role key).
# Server exchanges only access tokens verified via https://<project>.supabase.co/auth/v1/user.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# In production, generate at least 32 random bytes and set the same value
# as the Cloudflare API Worker secret EDGE_SHARED_SECRET.
EDGE_SHARED_SECRET=
# Required in production; at least 32 random bytes.
JWT_SECRET=
# Required to enroll/verify TOTP MFA. Generate with: openssl rand -base64 32
# Keep stable across API replicas; store in a secrets manager and never commit the real value.
MFA_ENCRYPTION_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/breezze
REDIS_URL=redis://localhost:6379
# Shared API IP quota (enforced atomically in Redis across API replicas).
API_RATE_LIMIT=100
API_RATE_WINDOW_MS=60000
# Additional per-account quota for POST /auth/login (identifier is hashed in Redis).
LOGIN_ACCOUNT_RATE_LIMIT=10
LOGIN_ACCOUNT_RATE_WINDOW_MS=900000
# MFA code attempts per source IP (shared Redis quota).
MFA_ATTEMPT_RATE_LIMIT=5
MFA_ATTEMPT_RATE_WINDOW_MS=900000
# Local URL for the optional ytmusicapi metadata sidecar (metadata only).
YTMUSIC_API_URL=http://127.0.0.1:8000

# Official YouTube Data API v3 for music-video metadata (NOT YouTube Music audio).
# Create a DEDICATED key restricted to this API; never use a key exposed in
# a chat or publish it in Flutter. Disabled by default in production until
# key rotation/restrictions are complete, after which explicitly opt in.
YOUTUBE_DATA_API_KEY=
YOUTUBE_DATA_API_ENABLED=false
# Redis-backed: 80 official music-video searches per Pacific day per project
# with 15-minute per-query caching; Google project quota may differ.

# Spotify is optional. Deezer public search remains usable without Spotify. Create a developer app at
# https://developer.spotify.com/dashboard. In 2026 development mode the
# app owner requires Premium and user access is capped at five.
# Credentials stay ONLY in the NestJS backend's secret environment.
# Spotify Web API metadata does not authorize raw/native audio or downloads:
# full tracks play inside Spotify via App Remote / official app handoff.
SPOTIFY_ENABLED=true
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Credential-free music metadata backup, ONLY for eligible noncommercial use.
# The public MusicBrainz API is rate-limited to < 1 request per second globally
# through Redis. Explicitly acknowledge its web-service terms before enabling.
# Not a Spotify proxy and never a full-song audio source.
MUSICBRAINZ_ENABLED=true
MUSICBRAINZ_NONCOMMERCIAL_ACK=false

# Artist pages prefer Spotify's verified artist ID/profile and use Deezer
# exclusively for missing sections after a unique exact-name match.
# Spotify's branding rules restrict mixed-service displays: do not enable
# production fallback until written partner/legal approval is in place.
# Development/test can exercise this path without enabling production use.
ARTIST_DEEZER_FALLBACK_APPROVED=false

# Deezer public catalogue API. Metadata discovery only; API access alone does
# not grant full-track streaming. Enable the approved Deezer playback SDK/widget
# separately before changing the adapter's playback capability.
DEEZER_ENABLED=true
DEEZER_API_URL=https://api.deezer.com

# Spotify music discovery + official YouTube video metadata. Legacy Deezer/YouTube
# Music metadata paths may remain for migration, but never supply music audio.
# Provider metadata and previews never constitute full-stream music rights.
NODE_ENV=development

# Cloudflare Worker custom domain. In production this must be HTTPS.
CDN_BASE_URL=https://media.breezze.app
# Generate with: openssl rand -base64 48
# Set the exact same value as the Cloudflare Worker secret MEDIA_SIGNING_KEY.
MEDIA_SIGNING_KEY=

# R2 S3-compatible credentials are used only by the backend media worker.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=breezze-media
MEDIA_ROOT=/tmp/breezze-media

# Comma-separated browser origins allowed to use credentialed API requests.
# In production, set this explicitly; an empty value denies browser origins.
CORS_ALLOWED_ORIGINS=https://breezze.app,https://www.breezze.app
