# Compose-level settings for the Breezze backend.
# Copy this file to backend/.env before running docker compose.
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
JWT_SECRET=
EDGE_SHARED_SECRET=
CDN_BASE_URL=http://localhost:3000/media
MEDIA_SIGNING_KEY=

# Development Compose defaults are injected when these values are blank.
# Production:
# - Set NODE_ENV=production.
# - Set EDGE_SHARED_SECRET to at least 32 random bytes; use the same value
#   with: npx wrangler secret put EDGE_SHARED_SECRET (API edge Worker).
# - Set MEDIA_SIGNING_KEY to at least 32 random bytes and configure the same
#   secret on the media Worker.
# - Set CDN_BASE_URL to the HTTPS media Worker hostname.
# - Set CORS_ALLOWED_ORIGINS to only your real web app origins.
