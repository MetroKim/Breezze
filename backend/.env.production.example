# Copy to backend/.env.production and replace every value before deployment.
# Use URL-safe hexadecimal passwords so DATABASE_URL does not need URL encoding.
POSTGRES_USER=breezze
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_HEX
POSTGRES_DB=breezze
REDIS_PASSWORD=REPLACE_WITH_DIFFERENT_LONG_RANDOM_HEX
JWT_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
EDGE_SHARED_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
MEDIA_SIGNING_KEY=REPLACE_WITH_64_HEX_CHARACTERS
MFA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_RANDOM_BYTES
CDN_BASE_URL=https://media.breezze.app
CORS_ALLOWED_ORIGINS=https://breezze.app,https://www.breezze.app
API_BIND_ADDRESS=0.0.0.0
API_RATE_LIMIT=100
API_RATE_WINDOW_MS=60000
LOGIN_ACCOUNT_RATE_LIMIT=10
LOGIN_ACCOUNT_RATE_WINDOW_MS=900000
MFA_ATTEMPT_RATE_LIMIT=5
MFA_ATTEMPT_RATE_WINDOW_MS=900000
# External music discovery: YouTube Music and Deezer only.
# The production Compose network sets YTMUSIC_API_URL=http://ytmusicapi:8000.
# For a separately deployed sidecar, set the API service's YTMUSIC_API_URL to its reachable HTTPS URL.
YTMUSIC_ENABLED=true
DEEZER_ENABLED=true
DEEZER_API_URL=https://api.deezer.com

# Optional read-only YouTube channel/playlist account linking (not native audio).
# Requires a Google Web OAuth client approved for youtube.readonly, with the
# exact callback URI registered in Google Cloud. Keep disabled until verified.
# Set the real client ID/secret and 32-byte base64 token key in Railway
# production secrets; preserve a previously active token key on redeploy.
YOUTUBE_ACCOUNT_LINK_ENABLED=false
YOUTUBE_ACCOUNT_CLIENT_ID=
YOUTUBE_ACCOUNT_CLIENT_SECRET=
YOUTUBE_ACCOUNT_REDIRECT_URI=https://breezze-api-edge.ykw8vmq7ph.workers.dev/api/v1/youtube-account/callback
YOUTUBE_ACCOUNT_TOKEN_KEY=
